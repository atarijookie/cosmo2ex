# .env for Windows - goes next to ce_run.exe as .env, read by ce_cores.exe, webserver.exe and ce_run.exe.
# Windows paths - ce_cores is a Cygwin program and converts them to Cygwin paths, the others are native Windows programs.
# Both / and \ work as separator.
#
# BIN_DIR is the folder of ce_run.exe (and of the programs, configdrive, ...) - ce_run.exe sets it, so it's not here.

# log level: 0 = off, 1 = errors, 2 = + warnings, 3 = + info, 4 = + debug (most info in the logs)
# default is 3 (info), override without editing this file by setting env var CE_LOG_LEVEL, e.g. CE_LOG_LEVEL=4
LOG_LEVEL=${CE_LOG_LEVEL:-3}

# main folders location - in the user's own folder, %LOCALAPPDATA%\cosmo2ex
# DATA_DIR - runtime data: command token, generated DESKTOP.INF
# PID_DIR  - pid files (Windows PIDs, as Task Manager shows them)
CE_DIR=${LOCALAPPDATA}/cosmo2ex
DATA_DIR=${CE_DIR}/data
LOG_DIR=${CE_DIR}/log
PID_DIR=${CE_DIR}/run
SETTINGS_DIR=${CE_DIR}/settings
# floppy images (e.g. from github.com/atarijookie/atari-st-floppy-image-downloader) - without an image in the drive, the
# floppy page of the web UI and browsing on the device start here
FLOPPY_IMAGES_DIR=${CE_DIR}/floppy_images

# pages printed on the emulated SLM 605/804 laser printer - one PNG file per page
PRINTOUTS_DIR=${CE_DIR}/printouts

# command socket - webserver sends commands to ce_cores as UDP datagrams on 127.0.0.1 (loopback only)
# every datagram must start with the token from CMD_TOKEN_FILE, regenerated on each ce_cores start
CMD_UDP_PORT=7310
CMD_TOKEN_FILE=${DATA_DIR}/core_cmd.token

# input socket - keyboard / mouse / joystick events from an external app (TCP on 127.0.0.1, loopback only),
# protocol described in ce_cores/ikbd/inputsocket.h; the app authenticates with the token from CMD_TOKEN_FILE
INPUT_TCP_PORT=7311

# config drive - used straight from here, the ST can read it but not change it (ce_cores refuses writes);
# generated DESKTOP.INF / NEWDESK.INF go to ${DATA_DIR}/configdrive_inf and show up in its root.
# For development, override it in .env.local (next to this file, not shipped), e.g.:
# CONFIG_DRIVE_DIR=/path/to/cosmo2ex/ce_cores/configdrive
CONFIG_DRIVE_DIR=${BIN_DIR}/configdrive

# MACs of devices connected to ce_cores right now (one per line), written by ce_cores, read by the webserver
CONNECTED_DEVICES_FILE=${DATA_DIR}/connected_devices

# files loaded by ce_cores at start - drivers for translated drive boot, screencast logo
CE_DD_BS_L1_FILE=${CONFIG_DRIVE_DIR}/drivers/ce_dd.bs
CE_DD_BS_L2_FILE=${CONFIG_DRIVE_DIR}/drivers/ce_dd_l2.bs
CE_DD_PRG_FILE=${CONFIG_DRIVE_DIR}/drivers/ce_dd.prg
CE_LOGO_FILE=${BIN_DIR}/ce_logo.bin

# screencast / screenshot settings
SCREENSHOT_VBL_ENABLED_FILE=${DATA_DIR}/screenshot_vbl_enabled

# webserver settings
WEBSERVER_PORT=8080

# web browser (CE_BROWS.PRG) - ce_browser is started when CE_BROWS.PRG starts, and stopped after BROWSER_IDLE_MIN minutes without use
#BROWSER_BIN=${BIN_DIR}/ce_browser.exe
# when ce_cores runs as root, ce_browser runs as this user (default: the one who ran sudo)
#BROWSER_USER=
BROWSER_IDLE_MIN=10

# video / audio players (CE_VIDEO.TTP, CE_AUDIO.TTP) - ce_media decodes the files with ffmpeg. It's started when a player
# starts, and stopped after MEDIA_IDLE_MIN minutes without use. Default MEDIA_BIN: ce_media in BIN_DIR, if it's there.
#MEDIA_BIN=${BIN_DIR}/ce_media
# ffmpeg / ffprobe binaries (default: from PATH) - or leave them and run ffmpeg in docker with MEDIA_DOCKER_IMAGE
#MEDIA_FFMPEG=/usr/bin/ffmpeg
#MEDIA_FFPROBE=/usr/bin/ffprobe
#MEDIA_DOCKER_IMAGE=linuxserver/ffmpeg
# plain ST sound: YM volume table file (256 x 16 B, as ST demos used) instead of the one ce_media makes
#MEDIA_YM_TABLE=
# when ce_cores runs as root, ce_media runs as this user (default: the one who ran sudo)
#MEDIA_USER=
MEDIA_IDLE_MIN=10
