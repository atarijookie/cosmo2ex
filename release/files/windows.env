# .env for Windows - goes next to ce_run.exe as .env, read by ce_cores.exe, webserver.exe and ce_run.exe.
# Windows paths - ce_cores is a Cygwin program and converts them to Cygwin paths, the others are native Windows programs.
# Both / and \ work as separator.
#
# BIN_DIR is the folder of ce_run.exe (and of the programs, configdrive, ...) - ce_run.exe sets it, so it's not here.

# log level: 0 = off, 1 = errors, 2 = + warnings, 3 = + info, 4 = + debug (most info in the logs)
# default is 3 (info), override without editing this file by setting env var CE_LOG_LEVEL, e.g. CE_LOG_LEVEL=4
LOG_LEVEL=${CE_LOG_LEVEL:-3}

# main folders location - in the user's own folder, %LOCALAPPDATA%\cosmo2ex
# DATA_DIR - runtime data: command token, copy of config drive
# PID_DIR  - pid files (Windows PIDs, as Task Manager shows them)
CE_DIR=${LOCALAPPDATA}/cosmo2ex
DATA_DIR=${CE_DIR}/data
LOG_DIR=${CE_DIR}/log
PID_DIR=${CE_DIR}/run
SETTINGS_DIR=${CE_DIR}/settings
# floppy images (e.g. from github.com/atarijookie/atari-st-floppy-image-downloader) - without an image in the drive, the
# floppy page of the web UI and browsing on the device start here
FLOPPY_IMAGES_DIR=${CE_DIR}/floppy_images

# command socket - webserver sends commands to ce_cores as UDP datagrams on 127.0.0.1 (loopback only)
# every datagram must start with the token from CMD_TOKEN_FILE, regenerated on each ce_cores start
CMD_UDP_PORT=7310
CMD_TOKEN_FILE=${DATA_DIR}/core_cmd.token

# input socket - keyboard / mouse / joystick events from an external app (TCP on 127.0.0.1, loopback only),
# protocol described in ce_cores/ikbd/inputsocket.h; the app authenticates with the token from CMD_TOKEN_FILE
INPUT_TCP_PORT=7311

# hdd core related settings and files - ce_run.exe copies BIN_DIR\configdrive here on each start
CONFIG_DRIVE_PATH=${DATA_DIR}/configdrive

# files loaded by ce_cores at start - drivers for translated drive boot, screencast logo
CE_DD_BS_L1_FILE=${BIN_DIR}/configdrive/drivers/ce_dd.bs
CE_DD_BS_L2_FILE=${BIN_DIR}/configdrive/drivers/ce_dd_l2.bs
CE_DD_PRG_FILE=${BIN_DIR}/configdrive/drivers/ce_dd.prg
CE_LOGO_FILE=${BIN_DIR}/ce_logo.bin

# screencast / screenshot settings
SCREENSHOT_VBL_ENABLED_FILE=${DATA_DIR}/screenshot_vbl_enabled

# webserver settings
WEBSERVER_PORT=8080
