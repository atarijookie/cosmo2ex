.pio_version 0          // only requires PIO version 0
.program scsi_write
.side_set 1             // side-set pin: REQ (board.pinReq), L = asserted

; Gets bytes from the initiator (COMMAND, DATA OUT, MESSAGE OUT) - "write" as seen from the Atari.
; Put N-1 into the TX FIFO to get N bytes, each comes to the RX FIFO in bits 31..24 (inverted, parity not read).
; ACK is on GP26 (PIN_ACK) on all boards.

start:
        pull                side 1          ; load from the TX FIFO into the OSR
        mov x, osr          side 1          ; X = OSR

wait4L: wait 0 gpio 26      side 0          ; set REQ to L, wait until ACK is L
        nop                 side 0  [2]     ; delay reading data by 60 ns
        in pins, 8          side 0  [5]     ; read 8 bits from gpio into ISR, with additional delay total up to 200 ns of REQ being L
        wait 1 gpio 26      side 1          ; REQ to H, wait until ACK is H

        push                side 1          ; put REQ back to H, push the contents of the ISR into the RX FIFO. Intentionally late in the routine to signal transfer end
        jmp x-- wait4L      side 1          ; If X is not zero, decrement and jump to get one more byte. X must be loaded to value N-1, if you want to load N bytes.


% c-sdk {
#include "hardware/clocks.h"
#include "hardware/gpio.h"

// the pin functions and directions are set by the bridge on each phase change (setDataDirection())
static inline void scsi_write_program_init(PIO pio, uint sm, uint offset, uint pinReq)
{
    pio_sm_config cWrite = scsi_write_program_get_default_config(offset);
    sm_config_set_in_pins(&cWrite, PIN_D0);                 // for IN - D0..D7
    sm_config_set_sideset_pins(&cWrite, pinReq);            // for SIDE_SET - REQ
    sm_config_set_in_shift(&cWrite, true, false, 32);       // Shift to right, autopush disabled
    sm_config_set_fifo_join(&cWrite, PIO_FIFO_JOIN_NONE);   // no fifo joining, we need both fifos

    float div = (float)clock_get_hz(clk_sys) / 50000000;    // calc divider for 50 MHz, that's 20 ns per instruction
    sm_config_set_clkdiv(&cWrite, div);

    pio_sm_init(pio, sm, offset, &cWrite);
}

%}
