#!/bin/sh

# log level: 0 = off, 1 = info, 2 = + errors, 3 = + warnings, 4 = + debug (most info in the logs)
# default is 3 (warnings), override without editing this file by setting env var CE_LOG_LEVEL, e.g. CE_LOG_LEVEL=4
LOG_LEVEL=${CE_LOG_LEVEL:-3}

# main folders location
DATA_DIR=/tmp/ce/data
LOG_DIR=/tmp/ce/log
PID_DIR=/tmp/ce/pid
CE_DIR=/opt/ce
BIN_DIR=${CE_DIR}/bin
SETTINGS_DIR=${CE_DIR}/settings

# command socket path
CMD_SOCK_PATH=${DATA_DIR}/core_cmd.sock

# hdd core related settings and files
CORE_HDD_STATUS_FILE=${DATA_DIR}/core_hdd_status.json
CONFIG_DRIVE_PATH=${DATA_DIR}/configdrive

# files loaded by ce_cores at start - drivers for translated drive boot, screencast logo
CE_DD_BS_L1_FILE=${BIN_DIR}/configdrive/drivers/ce_dd.bs
CE_DD_BS_L2_FILE=${BIN_DIR}/configdrive/drivers/ce_dd_l2.bs
CE_DD_PRG_FILE=${BIN_DIR}/configdrive/drivers/ce_dd.prg
CE_LOGO_FILE=${BIN_DIR}/ce_logo.bin

# ikbd settings
IKBD_SERIAL_PORT=/dev/serial0
IKBD_VIRTUAL_DEVICES_PATH=${DATA_DIR}/vdev
IKBD_VIRTUAL_MOUSE_FILE=${IKBD_VIRTUAL_DEVICES_PATH}/mouse
IKBD_VIRTUAL_KEYBOARD_FILE=${IKBD_VIRTUAL_DEVICES_PATH}/kbd

# screencast / screenshot settings
SCREENCAST_MEMORY_NAME=/mem.ce_screencast
SCREENCAST_SEMAPHORE_NAME=/ce_screencast
SCREENSHOT_VBL_ENABLED_FILE=${DATA_DIR}/screenshot_vbl_enabled

# webserver settings
WEBSERVER_PORT=8080
